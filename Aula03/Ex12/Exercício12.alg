Algoritmo "Exercicio12"

{ Descrição: Crie um algoritmo que exiba os números de 10 até 1 e no final escreva "Feliz Ano novo!".}
// Autor(a): Eduardo Felipe
// Data: 08/08/2026

Var
i: inteiro

Inicio
    i <- 10
    
    enquanto i >= 0 faca
    escreval(i,"")
    i <- i - 1
    fimenquanto
    escreval("Feliz Ano Novo!")


fimalgoritmo