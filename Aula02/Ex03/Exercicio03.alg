Algoritmo "Exercicio03"

// Descrição: Ler um número do usuário e exibir o dobro
// Autor(a): Eduardo Felipe
// Data: 04/08/2026

Var
  numero, dobro: inteiro


Inicio
  escreval("Informe um número para descobrir seu dobro: ")
  leia(numero)
  dobro <- numero * 2 //Realizando operação para descobrir o dobro do número informado

  escreval("O dobro de ", numero," é ", dobro,".")




fimalgoritmo