Algoritmo "Exercicio"

{ Descrição:      }
// Autor(a): Eduardo Felipe
// Data: 09/08/2026

Var
quantidadeEstoque: inteiro

Inicio
    escreval("Informe a quantidade do produto em estoque: ")
    leia(quantidadeEstoque)

    se quantidadeEstoque <= 10 entao
        escreval("Reposição Necessária!")
    senao
        escreval("Estoque Suficiente!")
    fimse

    


fimalgoritmo